# Ilova uchun maxfiy kalit kerak emas: Firebase web konfiguratsiyasi src/lib/firebase.ts da.
# Faqat kompyuterda sinash uchun — Firebase emulyatoriga ulash (production bazaga tegmaydi):
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Isolated test Firebase project (public web configuration only, not service account credentials).
# EXPO_PUBLIC_N99_ENV=staging
# EXPO_PUBLIC_N99_STAGING_CONFIG={"projectId":"n99-staging-example","apiKey":"...","appId":"...","authDomain":"n99-staging-example.firebaseapp.com","databaseURL":"https://n99-staging-example-default-rtdb.europe-west1.firebasedatabase.app"}

# Optional staging-only Worker order service (see backend/README.md).
# EXPO_PUBLIC_N99_BACKEND=worker

# Separate synthetic-only Firestore candidate. Do NOT use until operator confirms isolated dataset.
# EXPO_PUBLIC_N99_BACKEND=firestore-candidate
