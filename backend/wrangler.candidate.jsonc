{
  "name": "optovik-n99-firestore-candidate",
  "main": "firestore-worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "optovik-n99-staging",
    "FIREBASE_DATABASE_URL": "https://optovik-n99-staging-default-rtdb.europe-west1.firebasedatabase.app",
    "N99_FIRESTORE_CANDIDATE": "disabled",
    "N99_DATASET": "synthetic-only"
  }
}
